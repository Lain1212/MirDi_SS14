skills-auto-announcement-sender = CentCom Personnel Department

skills-auto-disabled-announcement =
    Attention! The station crew has dropped to { $count } { $count ->
        [one] member
       *[other] members
    }.
    Due to understaffing the skill system is TEMPORARILY DISABLED: any crew member may perform work outside of their specialty without speed penalties.

skills-auto-enabled-announcement =
    Attention! The station crew is back up to { $count } { $count ->
        [one] member
       *[other] members
    }.
    The skill system is ACTIVE AGAIN: work outside of your specialty is slower once more.
